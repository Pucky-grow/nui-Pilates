# Non-secret compose settings only. Never place application credentials in this file.
SERVER_IMAGE=PRIVATE_REGISTRY/pilates-server@sha256:REVIEWED_DIGEST
ADMIN_IMAGE=PRIVATE_REGISTRY/pilates-admin@sha256:REVIEWED_DIGEST
EDGE_IMAGE=PRIVATE_REGISTRY/pilates-edge@sha256:REVIEWED_DIGEST
APP_PROFILE=staging
APP_CONFIG_FILE=/etc/pilates/secrets/application.properties
TLS_DIRECTORY=/etc/pilates/certs
HTTPS_PORT=8443
