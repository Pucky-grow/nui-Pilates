# ISOLATED TEST ONLY. Not a production template. Secrets are intentionally empty.
PILATES_RUN_MODE=application
SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080
TZ=Asia/Shanghai
CLOUDRUN_PRIVATE_MYSQL_ENABLED=true
CLOUDRUN_ENVIRONMENT_ID=replace-with-isolated-cloudrun-environment-id
CLOUDRUN_PRIVATE_MYSQL_ACK=isolated-test-private-network-no-mysql-tls
DATABASE_URL=jdbc:mysql://mysql-test.invalid:3306/uni_pilates_test?sslMode=DISABLED&connectionTimeZone=Asia/Shanghai&connectTimeout=5000&socketTimeout=10000
MYSQL_USER=uni_pilates_runtime
MYSQL_PASSWORD=
REDIS_HOST=redis-test.invalid
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=true
REDIS_SSL_BUNDLE=tencent-redis
REDIS_CA_CERT=classpath:certificates/tencent-redis-ca.pem
JWT_SECRET=
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
WX_APPID=replace-with-test-app-id
WX_SECRET=
WX_LOGIN_ENABLED=true
WX_MOCK_LOGIN=false
WX_PHONE_ENABLED=false
SMS_MOCK_ENABLED=false
PAY_MOCK_ENABLED=false
PACKAGE_SALES_ENABLED=false
SCHEDULING_ENABLED=true
DELIVERY_WORKERS_ENABLED=true
STORAGE_TYPE=cos
COS_REGION=ap-shanghai
COS_BUCKET=replace-with-test-bucket
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# Enable only after V004 and its runtime grants are applied.
STUDIO_LEDGER_ENABLED=false
