# Non-secret checklist ONLY. Enter real values through the platform's protected settings.
# This file is not put in the upload ZIP or image. Blank dependencies must block startup.
SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080
TZ=Asia/Shanghai
DATABASE_URL=
MYSQL_USER=uni_pilates_runtime
MYSQL_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=true
REDIS_SSL_BUNDLE=tencent-redis
REDIS_CA_CERT=classpath:certificates/tencent-redis-ca.pem
JWT_SECRET=
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
WX_APPID=wxd9bd556ad0c77104
WX_SECRET=
WX_LOGIN_ENABLED=true
WX_MOCK_LOGIN=false
WX_PHONE_ENABLED=false
SMS_MOCK_ENABLED=false
PAY_MOCK_ENABLED=false
PACKAGE_SALES_ENABLED=false
SCHEDULING_ENABLED=true
DELIVERY_WORKERS_ENABLED=true
# Dedicated private COS bucket; backend proxies file access. Startup verifies owner-only bucket ACL.
# Bucket Policy/CDN/public access and actual cloud credentials still need operator verification.
# STS tokens are optional; provided tokens expire and must be rotated through protected settings.
STORAGE_TYPE=cos
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# Enable only after V004 and its runtime grants are applied.
STUDIO_LEDGER_ENABLED=false
