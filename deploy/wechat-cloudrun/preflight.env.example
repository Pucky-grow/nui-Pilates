# Non-secret template. Runtime credentials must be filled through protected platform settings.
# Preflight is NOT the booking backend. No Redis, WeChat login or business endpoints are started.
PILATES_RUN_MODE=preflight
SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080
TZ=Asia/Shanghai
CLOUDRUN_PRIVATE_MYSQL_ENABLED=true
CLOUDRUN_ENVIRONMENT_ID=uni-test-d5gwbyymua6bf2ada
# Explicitly reviewed isolated-test exception; no MySQL transport encryption.
CLOUDRUN_PRIVATE_MYSQL_ACK=isolated-test-private-network-no-mysql-tls
DATABASE_URL=jdbc:mysql://10.39.100.38:3306/uni_pilates_test?sslMode=DISABLED&connectionTimeZone=Asia/Shanghai&connectTimeout=5000&socketTimeout=10000
MYSQL_USER=uni_pilates_runtime
MYSQL_PASSWORD=
# This isolated MySQL8.0.30 runtime account uses mysql_native_password; never enable blind RSA key retrieval.
STORAGE_TYPE=cos
COS_REGION=ap-shanghai
COS_BUCKET=yoyi-pilates-test-1505023965
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# Enable only after V004 and its runtime grants are applied.
STUDIO_LEDGER_ENABLED=false
