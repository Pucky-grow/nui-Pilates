FROM maven:3.9.11-eclipse-temurin-17@sha256:e4a7ace3dc0d645ed97f8d9ad0b0d3f0b14fa8d150138f27f116d7105a639b82 AS build
# Build with the repository root as context.
RUN apt-get update && apt-get install --no-install-recommends -y python3 redis-server && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY server/pom.xml ./server/pom.xml
COPY server/src ./server/src
COPY scripts/test-isolated.py ./scripts/test-isolated.py
RUN python3 -B scripts/test-isolated.py --online --package -Dpilates.build.directory=/build/target
FROM eclipse-temurin:17.0.20.1_1-jre-jammy@sha256:8993f1aed8b25fcea7a7047a7949c1866fa558fc6830d938c22c4f13b26be9d7
RUN apt-get update && apt-get install --no-install-recommends -y libssl3=3.0.2-0ubuntu1.30 libfreetype6=2.11.1+dfsg-1ubuntu0.4 libpng16-16=1.6.37-3ubuntu0.7 && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 pilates && useradd --uid 10001 --gid pilates --no-create-home pilates && mkdir -p /data/uploads && chown pilates:pilates /data/uploads
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/target/pilates-server.jar /app/app.jar
USER 10001:10001
ENV TZ=Asia/Shanghai JAVA_TOOL_OPTIONS="-Duser.timezone=Asia/Shanghai -XX:MaxRAMPercentage=70"
EXPOSE 8080 9091
ENTRYPOINT ["java","-Dpilates.production.artifact=true","-jar","/app/app.jar"]
