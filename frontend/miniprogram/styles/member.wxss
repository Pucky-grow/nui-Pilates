.member-page { padding: 28rpx 28rpx 36rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); color: #39352f; }
.member-card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin: 0 0 20rpx; }
.member-title { font-weight: 650; font-size: 36rpx; line-height: 1.3; }
.member-heading { font-weight: 650; font-size: 30rpx; line-height: 1.4; }
.member-meta { color: #625d52; font-size: 26rpx; line-height: 1.55; }
.member-state { padding: 38rpx 20rpx; text-align: center; color: #625d52; font-size: 27rpx; }
.member-state .member-action { display: table; margin: 20rpx auto 0; }
.member-action { box-sizing: border-box; margin: 0; min-height: 76rpx; padding: 14rpx 24rpx; border-radius: 14rpx; background: #40563b; color: #fff; font-size: 27rpx; line-height: 1.65; font-weight: 600; white-space: normal; }
.member-action::after, .member-chip::after { border: 0; }
.member-action[disabled] { color: #625d52; background: #eae8e1; }
.member-action.secondary { background: #eaf0e5; color: #364b32; }
.member-action.quiet { background: transparent; color: #364b32; }
.member-tabs { display: flex; gap: 8rpx; padding: 8rpx; border-radius: 18rpx; background: #ebece5; margin-bottom: 20rpx; }
.member-chip { flex: 1; min-width: 0; margin: 0; padding: 12rpx 8rpx; min-height: 72rpx; border-radius: 12rpx; line-height: 1.65; font-size: 26rpx; background: transparent; color: #59584e; }
.member-chip.selected { color: #364b32; background: #fff; font-weight: 650; }
.member-pill { color: #364b32; background: #eaf0e5; border-radius: 8rpx; padding: 4rpx 12rpx; font-size: 24rpx; }
.member-between { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.member-section { margin: 30rpx 0 14rpx; }
.member-line + .member-line { border-top: 1rpx solid #e9e5dc; }
