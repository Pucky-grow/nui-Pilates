<view class="member-page">
  <view class="member-between">
    <view class="member-title">找一节课</view>
    <button class="member-action secondary filter-action" aria-expanded="{{showFilters}}" bindtap="toggleFilters">{{timeOfDay || difficulty ? '筛选 · 已选' : '筛选'}}</button>
  </view>
  <scroll-view scroll-x class="date-scroll" wx:if="{{days.length}}">
    <view class="dates">
      <button wx:for="{{days}}" wx:key="date" class="date-button {{dayIndex === index ? 'selected' : ''}}" aria-pressed="{{dayIndex === index}}" bindtap="onDay" data-i="{{index}}">
        <text class="date-label">{{item.label}}</text><text>{{item.short}}</text>
      </button>
    </view>
  </scroll-view>
  <view wx:if="{{showFilters}}" class="member-card filters">
    <view class="filter-options">
      <button wx:for="{{times}}" wx:key="key" class="filter-chip {{timeOfDay === item.key ? 'selected' : ''}}" bindtap="onTime" data-v="{{item.key}}">{{item.label}}</button>
    </view>
    <view class="filter-options">
      <button wx:for="{{difficulties}}" wx:key="key" class="filter-chip {{difficulty === item.key ? 'selected' : ''}}" bindtap="onDifficulty" data-v="{{item.key}}">{{item.label}}</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="member-state">正在查找场次…</view>
  <view wx:elif="{{error}}" class="member-state">{{error}}<button class="member-action secondary" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{!schedules.length}}" class="member-state">
    {{timeOfDay || difficulty ? '这个日期没有符合筛选的课程' : '这个日期暂无排课，试试其他日期'}}
    <button wx:if="{{timeOfDay || difficulty}}" class="member-action secondary" bindtap="resetFilters">清除筛选</button>
  </view>
  <block wx:else>
    <view class="member-card schedule-card" wx:for="{{schedules}}" wx:key="id">
      <view class="member-between schedule-top">
        <text class="schedule-time">{{item.timeText}}</text>
        <text wx:if="{{item.bookable}}" class="member-pill">剩 {{item.remaining}} 席</text>
        <text wx:elif="{{item.bookingStatus === 'FULL'}}" class="member-pill sold-out">已满员</text>
      </view>
      <view class="member-heading course-title" bindtap="goCourseDetail" data-cid="{{item.courseId}}">{{item.courseName}} ›</view>
      <view class="member-meta">{{item.coachName}}<text wx:if="{{item.classroomName}}"> · {{item.classroomName}}</text><text wx:if="{{item.difficultyText}}"> · {{item.difficultyText}}</text></view>
      <view class="schedule-action">
        <button wx:if="{{item.bookable}}" class="member-action" bindtap="goDetail" data-id="{{item.id}}">预约</button>
        <button wx:elif="{{waitlistEnabled && item.bookingStatus === 'FULL'}}" class="member-action secondary" bindtap="goDetail" data-id="{{item.id}}">查看候补</button>
        <text wx:elif="{{item.bookingStatus !== 'FULL'}}" class="member-meta">{{item.unbookableReason || '当前不可预约'}}</text>
      </view>
    </view>
  </block>
</view>
