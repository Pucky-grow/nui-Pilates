.user-card { display: flex; align-items: center; padding: 40rpx 32rpx; }
.user-avatar { width: 120rpx; height: 120rpx; }
.user-info { margin-left: 24rpx; }
.user-name { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.stat-row { display: flex; }
.stat { flex: 1; text-align: center; display: flex; flex-direction: column; gap: 6rpx; }
.stat-num { font-size: 36rpx; font-weight: 700; color: var(--sage-deep); }
.menu-item { display: flex; justify-content: space-between; padding: 26rpx 8rpx; border-bottom: 2rpx solid var(--line); }
.menu-item:last-child { border-bottom: none; }
.logout-btn { margin-top: 20rpx; text-align: center; color: var(--danger); padding: 20rpx 0; border-top: 2rpx solid var(--line); }
.menu-btn { width: 100%; display: flex; justify-content: space-between; background: transparent; border: none; padding: 0; font-size: inherit; line-height: inherit; border-radius: 0; color: var(--text); text-align: left; }
.menu-btn::after { border: none; }
.avatar-btn { padding: 0; background: transparent; border: none; line-height: 1; margin: 0; }
.avatar-btn::after { border: none; }
.edit-hint { font-size: 24rpx; color: var(--text-light); margin-top: 8rpx; }
.nickname-edit { padding: 24rpx; }
.row-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
.row-btns .btn-plain, .row-btns .btn-primary { flex: 1; }
.group-title { font-size: 24rpx; color: var(--text-light); padding: 8rpx 8rpx 4rpx; }
.coach-entry { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; margin-bottom: 16rpx; background: var(--sage-deep); border-radius: 16rpx; }
.coach-entry-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.coach-entry-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 6rpx; }
.coach-entry-arrow { color: #fff; font-size: 40rpx; }
.bind-phone { margin-top: 12rpx; padding: 0; background: transparent; border: none; font-size: 24rpx; color: var(--sage-deep); text-align: left; line-height: 1.4; }
.bind-phone::after { border: none; }
.bind-phone-mock { display: flex; gap: 12rpx; align-items: center; margin-top: 12rpx; }
.bind-phone-mock .input { flex: 1; margin-bottom: 0; height: 64rpx; line-height: 64rpx; padding: 0 16rpx; }
.bind-phone-mock .btn-plain { flex-shrink: 0; padding: 8rpx 24rpx; font-size: 26rpx; }
.link { color: var(--sage-deep); }
.phone-row { display: flex; gap: 16rpx; align-items: center; margin-top: 12rpx; }
.stat:active { opacity: 0.7; }
.modal-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-panel { width: 82%; background: #fff; border-radius: 20rpx; padding: 40rpx 32rpx; box-sizing: border-box; }
.modal-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.modal-input { border: 2rpx solid var(--line); border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; width: 100%; box-sizing: border-box; }
.char-count { text-align: right; font-size: 22rpx; color: var(--text-light); margin: 8rpx 0 8rpx; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-btns .btn-plain, .modal-btns .btn-primary { flex: 1; }
.code-row { display: flex; gap: 12rpx; align-items: center; margin-top: 16rpx; }
.code-input { flex: 1; }
.code-btn { flex-shrink: 0; padding: 0 24rpx; font-size: 26rpx; height: 80rpx; line-height: 76rpx; }
