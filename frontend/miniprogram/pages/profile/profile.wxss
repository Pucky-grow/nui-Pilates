@import "../../styles/member.wxss";
.user-card { display: flex; gap: 20rpx; align-items: center; padding: 12rpx 0 28rpx; }
.user-avatar { width: 108rpx; height: 108rpx; }
.user-info { min-width: 0; }
.edit-hint { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 7rpx; font-size: 25rpx; }
.wallet-card { background: #40563b; color: #fff; }
.wallet-link, .wallet-meta { color: #e6efe2; font-size: 26rpx; }
.wallet-accounts { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 14rpx; }
.wallet-account { flex: 1; min-width: 215rpx; overflow-wrap: anywhere; }
.wallet-amount { font-size: 48rpx; line-height: 1.2; font-weight: 700; }
.wallet-meta, .wallet-retry { margin-top: 8rpx; }
.shortcuts { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0; background: transparent; }
.shortcuts button { flex: 1; min-width: 155rpx; }
.link-list { padding: 2rpx 26rpx; }
.link-list .member-line { padding: 22rpx 0; font-size: 28rpx; }
.logout-btn { margin: 14rpx auto; }
.avatar-btn { padding: 0; background: transparent; border: none; line-height: 1; margin: 0; }
.avatar-btn::after { border: none; }
.coach-entry { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; margin-bottom: 16rpx; background: var(--sage-deep); border-radius: 16rpx; }
.coach-entry-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.coach-entry-arrow { color: #fff; font-size: 40rpx; }
.link { color: var(--sage-deep); }
.phone-row { display: flex; gap: 16rpx; align-items: center; margin-top: 12rpx; }
.modal-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-panel { width: 82%; background: #fff; border-radius: 20rpx; padding: 40rpx 32rpx; box-sizing: border-box; }
.modal-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.modal-input { border: 2rpx solid var(--line); border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; width: 100%; box-sizing: border-box; }
.char-count { text-align: right; font-size: 22rpx; color: var(--text-light); margin: 8rpx 0 8rpx; }
.modal-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-btns .btn-plain, .modal-btns .btn-primary { flex: 1; }
