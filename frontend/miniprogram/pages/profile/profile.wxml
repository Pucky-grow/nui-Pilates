<view class="page">
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{profile.avatarUrl}}" class="avatar user-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar user-avatar coach-avatar-fallback">{{profile.nickname}}</view>
    </button>
    <view class="user-info">
      <view class="user-name">{{profile.nickname || '优仪会员'}}</view>
      <view class="tag">{{profile.levelName}}</view>
      <view class="edit-hint">
        <text class="link" bindtap="editNickname">编辑昵称</text>
        <text class="muted"> · 点头像用微信头像 · </text>
        <text class="link" bindtap="onChooseAlbum">从相册选择</text>
      </view>
      <view class="phone-row" wx:if="{{profile}}">
        <text wx:if="{{profile.phoneBound}}">{{profile.phone}}</text>
        <button wx:if="{{phoneEnabled}}" open-type="getPhoneNumber" bindgetphonenumber="bindWechatPhone">{{profile.phoneBound ? '更换手机号' : '授权手机号'}}</button>
        <text wx:elif="{{!profile.phoneBound}}" class="muted">手机号绑定暂未开放</text>
      </view>
    </view>
  </view>

  <!-- 教练工作台入口(教练专属, 置顶) -->
  <view wx:if="{{isCoach}}" class="coach-entry" bindtap="goCoachEnd">
    <view>
      <view class="coach-entry-title">教练工作台</view>
      <view class="coach-entry-sub">课表 · 学员 · 训练记录</view>
    </view>
    <text class="coach-entry-arrow">›</text>
  </view>

  <view class="stat-row card">
    <view class="stat" bindtap="goTraining">
      <text class="stat-num">{{profile.totalSessions}}</text>
      <text class="muted">累计训练</text>
    </view>
    <view class="stat" bindtap="goPoints">
      <text class="stat-num">{{points}}</text>
      <text class="muted">积分</text>
    </view>
    <view class="stat" bindtap="goPackages">
      <text class="stat-num">{{profile.totalConsumption}}</text>
      <text class="muted">累计消费</text>
    </view>
  </view>

  <!-- 我的约课 -->
  <view class="menu card">
    <view class="group-title">我的约课</view>
    <view wx:if="{{studioLedger}}" class="menu-item" bindtap="goLedger"><text>历史课程与余额</text><text>›</text></view>
    <view class="menu-item" bindtap="goBookings"><text>我的预约</text><text>›</text></view>
    <view class="menu-item" bindtap="goTraining"><text>训练记录</text><text>›</text></view>
    <view class="menu-item" bindtap="goAssessment"><text>身体评估</text><text>›</text></view>
    <view class="menu-item" bindtap="goReviews"><text>课程评价</text><text>›</text></view>
  </view>

  <!-- 我的服务 -->
  <view class="menu card">
    <view class="group-title">我的服务</view>
    <view class="menu-item" bindtap="goMessage"><text>消息中心</text><text wx:if="{{unread}}">({{unread}})</text><text>›</text></view>
    <view class="menu-item" bindtap="goPackages"><text>我的课包</text><text>›</text></view>
    <view class="menu-item" bindtap="goCoupons"><text>优惠券</text><text>›</text></view>
    <view class="menu-item" bindtap="goPoints"><text>积分</text><text>›</text></view>
    <view class="menu-item" bindtap="goInvite"><text>邀请好友</text><text>›</text></view>
    <view class="menu-item" bindtap="goFeedback"><text>意见反馈</text><text>›</text></view>
  </view>

  <!-- 账户 -->
  <view class="menu card">
    <view class="group-title">账户</view>
    <view class="menu-item">
      <text>当前登录</text>
      <text class="muted">{{identity}}</text>
    </view>
    <view wx:if="{{studioLedger}}" class="menu-item" bindtap="goOfflineClaim"><text>绑定线下会员档案</text><text>›</text></view>
    <view class="menu-item" bindtap="switchAccount"><text>切换账号</text><text>›</text></view>
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>

  <!-- 昵称弹窗 -->
  <view wx:if="{{showNickname}}" class="modal-mask">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-title">修改昵称</view>
      <input class="modal-input" type="nickname" maxlength="12" value="{{nicknameInput}}" bindinput="onNicknameInput" placeholder="请输入昵称" />
      <view class="char-count">{{nicknameLen}}/12</view>
      <view class="modal-btns">
        <button class="btn-plain" bindtap="cancelNickname">取消</button>
        <button class="btn-primary" disabled="{{!nicknameInput}}" bindtap="saveNickname">保存</button>
      </view>
    </view>
  </view>

</view>
