<view class="member-page">
  <view wx:if="{{profile}}" class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="更换微信头像">
      <image wx:if="{{profile.avatarUrl}}" class="avatar user-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar user-avatar coach-avatar-fallback">会员</view>
    </button>
    <view class="user-info">
      <view class="member-title">{{profile.nickname || '优仪会员'}}</view>
      <text class="member-meta">{{profile.levelName}}</text>
      <view class="edit-hint"><text class="link" bindtap="editNickname">编辑昵称</text><text class="link" bindtap="onChooseAlbum">从相册换头像</text></view>
      <view class="phone-row" wx:if="{{phoneEnabled || profile.phoneBound}}">
        <text wx:if="{{profile.phoneBound}}" class="member-meta">{{profile.phone}}</text>
        <button wx:if="{{phoneEnabled}}" class="member-action secondary" open-type="getPhoneNumber" bindgetphonenumber="bindWechatPhone">{{profile.phoneBound ? '更换手机号' : '授权手机号'}}</button>
      </view>
    </view>
  </view>
  <view wx:elif="{{profileError}}" class="member-state">{{profileError}}<button class="member-action secondary" bindtap="loadProfile">重新加载</button></view>
  <view wx:else class="member-state">正在读取会员资料…</view>

  <view wx:if="{{isCoach}}" class="coach-entry" bindtap="goCoachEnd">
    <view class="coach-entry-title">教练工作台</view><text class="coach-entry-arrow">›</text>
  </view>

  <view wx:if="{{studioLedger}}" class="member-card wallet-card">
    <view class="member-between">
      <view class="member-heading">可用余额</view>
      <text class="wallet-link" bindtap="goLedger">余额与账单 ›</text>
    </view>
    <view wx:if="{{walletLoading}}" class="wallet-meta">正在读取余额…</view>
    <view wx:elif="{{walletError}}" class="wallet-meta" bindtap="loadWallet">余额暂时无法读取 · 重试</view>
    <view wx:else class="wallet-accounts">
      <view wx:for="{{accounts}}" wx:key="bucket" class="wallet-account">
        <view class="wallet-amount">{{item.amount}}</view>
        <view class="wallet-meta">{{item.name}}</view>
      </view>
    </view>
  </view>
  <view wx:elif="{{walletError}}" class="member-meta wallet-retry" bindtap="loadWallet">余额服务暂时无法读取 · 重试</view>

  <view class="member-card shortcuts">
    <button class="member-action secondary" bindtap="goBookings">我的预约</button>
    <button class="member-action secondary" bindtap="goTraining">训练记录</button>
    <button wx:if="{{studioLedger}}" class="member-action secondary" bindtap="goLessonHistory">补录课程</button>
  </view>

  <view class="member-heading member-section">会员服务</view>
  <view class="member-card link-list">
    <view class="member-line member-between" bindtap="goMessage"><text>消息中心</text><text class="member-meta">{{unread ? unread + ' 条未读 ›' : '›'}}</text></view>
    <view class="member-line member-between" bindtap="goAssessment"><text>身体评估</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="goReviews"><text>课程评价</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="goPackages"><text>我的课包</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="goOrders"><text>历史订单</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="goCoupons"><text>优惠券</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="goPoints"><text>积分</text><text class="member-meta">{{points == null ? '›' : points + ' ›'}}</text></view>
    <view class="member-line member-between" bindtap="goInvite"><text>邀请好友</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="goFeedback"><text>意见反馈</text><text class="member-meta">›</text></view>
  </view>

  <view class="member-heading member-section">账户设置</view>
  <view class="member-card link-list">
    <view wx:if="{{identity}}" class="member-line member-between"><text>当前登录</text><text class="member-meta">{{identity}}</text></view>
    <view wx:if="{{studioLedger}}" class="member-line member-between" bindtap="goOfflineClaim"><text>绑定线下会员档案</text><text class="member-meta">›</text></view>
    <view class="member-line member-between" bindtap="switchAccount"><text>切换账号</text><text class="member-meta">›</text></view>
    <button class="member-action quiet logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 昵称弹窗 -->
  <view wx:if="{{showNickname}}" class="modal-mask">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-title">修改昵称</view>
      <input class="modal-input" type="nickname" maxlength="12" value="{{nicknameInput}}" bindinput="onNicknameInput" placeholder="请输入昵称" />
      <view class="char-count">{{nicknameLen}}/12</view>
      <view class="modal-btns">
        <button class="btn-plain" bindtap="cancelNickname">取消</button>
        <button class="btn-primary" disabled="{{!nicknameInput}}" bindtap="saveNickname">保存</button>
      </view>
    </view>
  </view>

</view>
