<view class="page">
  <view wx:if="{{!packageSales}}" class="card">当前免费预约，无需购买课包。已有课包和订单记录继续保留。</view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:if="{{error}}" class="card"><view>{{error}}</view><button bindtap="retry">重试</button></view>
  <view class="card" wx:for="{{history}}" wx:key="id"><view class="pkg-name">{{item.name}}</view><view>剩余 {{item.remainingCredits}} / {{item.totalCredits}} 课时</view><view class="muted">状态：{{item.status}} · 有效期：{{item.validUntil || '未设置'}}</view></view>
  <view wx:if="{{!loading && !error && !history.length}}" class="empty">暂无历史课包，免费预约不需要课包</view>
  <view wx:if="{{packageSales}}" class="card pkg-card" wx:for="{{packages}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}"><view class="pkg-name">{{item.name}}</view><view>{{item.description}}</view><view class="price">¥{{item.salePrice}}</view><view>查看课包</view></view>
</view>
