.cover { width: 100%; height: 360rpx; }
.name { font-size: 38rpx; font-weight: 700; }
.tags { margin: 16rpx 0; }
.slot { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 2rpx solid var(--line); }
.slot:last-child { border-bottom: none; }
.remain { margin-left: 16rpx; color: var(--sage-deep); font-size: 24rpx; }
.slot-btn { margin-left: auto; font-size: 24rpx; padding: 8rpx 30rpx; }
.review { padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.review:last-child { border-bottom: none; }
.r-score { color: var(--brown); margin-right: 12rpx; }
