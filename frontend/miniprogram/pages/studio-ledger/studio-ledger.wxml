<view class="member-page">
  <view class="member-card balance">
    <view class="member-heading">可用余额</view>
    <view wx:if="{{walletLoading}}" class="balance-meta">正在读取余额…</view>
    <view wx:elif="{{walletError}}" class="balance-meta">{{walletError}}<button class="member-action secondary" bindtap="loadWallet">重试余额</button></view>
    <view wx:else class="balance-grid">
      <view wx:for="{{accounts}}" wx:key="bucket" class="balance-item">
        <view class="balance-amount">{{item.amount}}</view>
        <view class="balance-meta">{{item.name}}</view>
      </view>
    </view>
  </view>
  <view class="member-tabs">
    <button wx:for="{{tabOptions}}" wx:key="key" class="member-chip {{tab === item.key ? 'selected' : ''}}" aria-pressed="{{tab === item.key}}" data-tab="{{item.key}}" bindtap="selectTab">{{item.label}}</button>
  </view>

  <view wx:if="{{tab === 'history'}}" class="member-meta ledger-note">这里显示门店补录的历史课。小程序内预约可在「我的预约」查看。</view>
  <view wx:if="{{listLoading && !groups.length}}" class="member-state">正在读取记录…</view>
  <view wx:if="{{listError}}" class="member-state">{{listError}}<button class="member-action secondary" bindtap="retryRows">重新加载</button></view>
  <view wx:if="{{!listLoading && !listError && !groups.length}}" class="member-state">{{emptyText[tab]}}</view>
  <block wx:for="{{groups}}" wx:for-item="group" wx:key="key">
    <view class="day-heading">{{group.date}}</view>
    <view class="member-card ledger-group">
      <view wx:for="{{group.rows}}" wx:key="id" class="member-line ledger-row">
        <view class="ledger-main">
          <view class="member-heading ledger-title">{{item.title}}</view>
          <view wx:if="{{item.detail}}" class="member-meta">{{item.detail}}</view>
          <view wx:if="{{item.note}}" class="member-meta">{{item.note}}</view>
        </view>
        <view wx:if="{{item.amount || item.status}}" class="ledger-value {{item.tone}}">
          <view wx:if="{{item.amount}}" class="ledger-amount">{{item.amount}}</view>
          <view wx:if="{{item.status}}">{{item.status}}</view>
        </view>
      </view>
    </view>
  </block>
  <button wx:if="{{more && !listError}}" class="member-action secondary load-more" loading="{{listLoading}}" disabled="{{listLoading}}" bindtap="next">加载更多</button>
</view>
