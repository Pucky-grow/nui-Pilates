.name { font-size: 36rpx; font-weight: 600; }
.time { color: var(--sage-deep); font-weight: 600; margin: 12rpx 0; }
.go-btn { width: 360rpx; margin: 30rpx auto; }
.pkg-option { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.pkg-option:last-child { border-bottom: none; }
.pkg-info { margin-left: 12rpx; }
.remark { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; }
.footer { padding: 24rpx; position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg); }
