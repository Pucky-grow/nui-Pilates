@import "../../styles/member.wxss";
.with-actions { padding-bottom: 136rpx; padding-bottom: calc(136rpx + env(safe-area-inset-bottom)); }
.detail-card .member-pill { flex-shrink: 0; }
.detail-time { color: #40563b; font-size: 32rpx; font-weight: 700; margin: 10rpx 0 6rpx; }
.detail-note { margin-top: 12rpx; }
.footer { display: flex; gap: 16rpx; padding: 20rpx 28rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); position: fixed; bottom: 0; left: 0; right: 0; background: var(--bg); }
.footer .member-action { flex: 1; }
