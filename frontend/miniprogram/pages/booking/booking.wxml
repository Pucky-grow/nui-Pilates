<view class="member-page">
  <view class="member-tabs">
    <button class="member-chip {{tab === 'upcoming' ? 'selected' : ''}}" aria-pressed="{{tab === 'upcoming'}}" data-tab="upcoming" bindtap="selectTab">待上课</button>
    <button class="member-chip {{tab === 'history' ? 'selected' : ''}}" aria-pressed="{{tab === 'history'}}" data-tab="history" bindtap="selectTab">历史预约</button>
  </view>

  <view wx:if="{{loading}}" class="member-state">正在查看预约…</view>
  <view wx:elif="{{error}}" class="member-state">{{error}}<button class="member-action secondary" bindtap="load">重新加载</button></view>
  <block wx:elif="{{tab === 'upcoming'}}">
    <view wx:if="{{!nextBooking}}" class="member-card member-state">
      暂时没有待上课的预约
      <button class="member-action" bindtap="goCourse">看看可约课程</button>
    </view>
    <block wx:else>
      <view class="member-card next-booking">
        <view class="member-between"><text class="next-label">最近一节</text><text class="member-pill">{{statusText[nextBooking.status]}}</text></view>
        <view class="next-time">{{nextBooking.dayText}} {{nextBooking.timeText}}</view>
        <view class="member-title">{{nextBooking.courseName}}</view>
        <view class="next-label">{{nextBooking.coachName}}<text wx:if="{{nextBooking.classroomName}}"> · {{nextBooking.classroomName}}</text></view>
        <view wx:if="{{nextBooking.checkinText}}" class="next-label">{{nextBooking.checkinText}}</view>
        <view class="booking-actions">
          <button class="member-action secondary" bindtap="goDetail" data-id="{{nextBooking.id}}">预约详情</button>
          <button wx:if="{{nextBooking.canCheckin}}" class="member-action sign-in" bindtap="checkin">去签到</button>
        </view>
      </view>
      <view wx:if="{{upcoming.length}}" class="member-heading member-section">后续预约</view>
      <view wx:for="{{upcoming}}" wx:key="id" class="member-card booking-row" bindtap="goDetail" data-id="{{item.id}}">
        <view class="member-between"><text class="member-heading">{{item.courseName}}</text><text class="member-pill">{{statusText[item.status]}}</text></view>
        <view class="booking-time">{{item.dayText}} {{item.timeText}}</view>
        <view class="member-meta">{{item.coachName}}<text wx:if="{{item.classroomName}}"> · {{item.classroomName}}</text></view>
      </view>
    </block>
  </block>
  <block wx:else>
    <view wx:if="{{!history.length}}" class="member-state">暂无历史预约</view>
    <view wx:else class="member-card history-list">
      <view wx:for="{{history}}" wx:key="id" class="member-line history-row">
        <view bindtap="goDetail" data-id="{{item.id}}">
          <view class="member-between"><text class="member-heading">{{item.courseName || '课程预约'}}</text><text class="member-pill history-status">{{statusText[item.status] || '预约记录'}}</text></view>
          <view class="member-meta">{{item.courseDate}} {{item.timeText}}<text wx:if="{{item.coachName}}"> · {{item.coachName}}</text></view>
          <view wx:if="{{item.feeText}}" class="member-meta">{{item.feeText}}</view>
        </view>
        <button wx:if="{{item.status === 'COMPLETED' && item.courseId}}" class="member-action secondary rebook" catchtap="goAgain" data-cid="{{item.courseId}}">再次预约</button>
      </view>
    </view>
  </block>
</view>
