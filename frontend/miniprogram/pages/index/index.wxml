<view class="member-page">
  <view class="home-intro">
    <view class="member-title">优仪普拉提</view>
    <view class="member-meta">{{slogan}}</view>
  </view>

  <view wx:if="{{planLoading}}" class="member-card member-state">正在查看上课安排…</view>
  <view wx:elif="{{planError}}" class="member-card member-state">
    {{planError}}<button class="member-action secondary" bindtap="loadPlans">重新加载</button>
    <button class="member-action quiet" bindtap="goCourse">查看课表</button>
  </view>
  <view wx:elif="{{nextBooking}}" class="member-card next-class">
    <view class="next-caption">下次上课</view>
    <view class="next-time">{{nextBooking.dayText}} {{nextBooking.timeText}}</view>
    <view class="next-name">{{nextBooking.courseName}}</view>
    <view class="next-meta">{{nextBooking.coachName}}<text wx:if="{{nextBooking.classroomName}}"> · {{nextBooking.classroomName}}</text></view>
    <view wx:if="{{nextBooking.checkinText}}" class="next-meta">{{nextBooking.checkinText}}</view>
    <view class="next-actions">
      <button class="member-action secondary" bindtap="goBooking">预约详情</button>
      <button wx:if="{{nextBooking.canCheckin}}" class="member-action checkin-action" bindtap="checkin">去签到</button>
    </view>
  </view>
  <view wx:else class="member-card available-card">
    <view class="member-heading">最近可约</view>
    <view wx:if="{{!available.length}}" class="member-meta no-slot">近 7 天暂无可约场次</view>
    <view wx:for="{{available}}" wx:key="id" class="member-line available-row" bindtap="goSchedule" data-id="{{item.id}}">
      <view>
        <view class="row-title">{{item.courseName}}</view>
        <view class="member-meta">{{item.dayText}} {{item.timeText}}<text wx:if="{{item.coachName}}"> · {{item.coachName}}</text></view>
      </view>
      <text class="member-pill">剩 {{item.remaining}} 席</text>
    </view>
    <button class="member-action" bindtap="goCourse">查看完整课表</button>
  </view>

  <view class="home-actions">
    <button wx:if="{{nextBooking}}" class="member-action secondary" bindtap="goCourse">浏览课表</button>
    <button class="member-action secondary" bindtap="goPrivate">私教预约</button>
  </view>

  <swiper wx:if="{{banners.length}}" class="home-banner" indicator-dots="{{banners.length > 1}}" indicator-active-color="#fff">
    <swiper-item wx:for="{{banners}}" wx:key="id" class="banner-slide">
      <image wx:if="{{item.imageUrl}}" class="banner-img" src="{{item.imageUrl}}" mode="aspectFill" />
      <view wx:if="{{item.title || item.subtitle}}" class="banner-copy">
        <view wx:if="{{item.title}}" class="member-heading">{{item.title}}</view>
        <view wx:if="{{item.subtitle}}" class="banner-subtitle">{{item.subtitle}}</view>
      </view>
    </swiper-item>
  </swiper>

  <block wx:if="{{hotCourses.length}}">
    <view class="member-heading member-section">门店推荐</view>
    <view class="member-card compact-list">
      <view wx:for="{{hotCourses}}" wx:key="courseId" class="member-line open-row" bindtap="goCourseDetail" data-id="{{item.courseId}}">
        <text class="row-title">{{item.courseName}}</text><text class="member-meta">{{item.typeText}} ›</text>
      </view>
    </view>
  </block>

  <block wx:if="{{coaches.length}}">
    <view class="member-between member-section">
      <view class="member-heading">教练团队</view><text class="member-meta" bindtap="goCoaches">全部教练 ›</text>
    </view>
    <scroll-view scroll-x class="coach-scroll">
      <view class="coach-list">
        <view wx:for="{{coaches}}" wx:key="coachId" class="member-card coach-card" bindtap="goCoach" data-id="{{item.coachId}}">
          <image wx:if="{{item.avatar}}" class="avatar coach-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="avatar coach-avatar coach-avatar-fallback">{{item.coachName}}</view>
          <view class="row-title">{{item.coachName}}</view>
          <view wx:if="{{item.coachTitle}}" class="member-meta">{{item.coachTitle}}</view>
        </view>
      </view>
    </scroll-view>
  </block>

  <block wx:if="{{articles.length}}">
    <view class="member-heading member-section">普拉提知识</view>
    <view class="member-card compact-list">
      <view wx:for="{{articles}}" wx:key="id" class="member-line open-row" bindtap="goArticle" data-id="{{item.id}}">
        <text class="row-title">{{item.title}}</text><text class="member-meta">›</text>
      </view>
    </view>
  </block>
  <button wx:if="{{contentError}}" class="member-action quiet content-retry" bindtap="loadContent">{{contentError}} · 重试</button>
  <view class="member-card open-row studio-row" bindtap="goAbout">
    <view><view class="row-title">工作室信息</view><view wx:if="{{studio.address}}" class="member-meta">{{studio.address}}</view></view>
    <text class="member-meta">›</text>
  </view>
</view>
