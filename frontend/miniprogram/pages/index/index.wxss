@import "../../styles/member.wxss";
.home-intro { padding: 8rpx 0 24rpx; }
.home-intro .member-meta { margin-top: 6rpx; }
.next-class { background: #40563b; color: #fff; padding: 32rpx; }
.next-caption, .next-meta { color: #ecf2e8; font-size: 26rpx; }
.next-time { font-size: 42rpx; font-weight: 700; margin-top: 6rpx; }
.next-name { font-size: 32rpx; font-weight: 650; margin-top: 4rpx; }
.next-meta { margin-top: 6rpx; }
.next-actions, .home-actions { display: flex; gap: 14rpx; }
.next-actions { margin-top: 24rpx; }
.next-actions .member-action { flex: 1; }
.checkin-action { background: #fff; color: #364b32; }
.home-actions { margin-bottom: 20rpx; }
.home-actions .member-action { flex: 1; }
.available-row, .open-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; }
.available-row .member-pill { flex-shrink: 0; }
.no-slot { margin: 10rpx 0 20rpx; }
.row-title { color: #39352f; font-size: 28rpx; font-weight: 600; }
.home-banner { height: 234rpx; border-radius: 22rpx; overflow: hidden; margin-bottom: 20rpx; }
.banner-slide { position: relative; background: #40563b; }
.banner-img { width: 100%; height: 100%; display: block; }
.banner-copy { position: absolute; inset: auto 0 0; background: linear-gradient(transparent, rgba(28, 40, 26, .85)); color: #fff; padding: 36rpx 26rpx 27rpx; }
.banner-subtitle { margin-top: 4rpx; color: #fff; font-size: 25rpx; }
.compact-list { padding: 4rpx 26rpx; }
.coach-scroll { white-space: nowrap; }
.coach-list { display: inline-flex; gap: 14rpx; }
.coach-card { min-width: 160rpx; max-width: 240rpx; text-align: center; white-space: normal; margin-bottom: 0; }
.coach-avatar { width: 88rpx; height: 88rpx; margin: 0 auto 8rpx; }
.studio-row { margin-top: 20rpx; padding: 24rpx 28rpx; }
.content-retry { margin: 12rpx auto; }
