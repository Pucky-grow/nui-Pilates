.cover-wrap { width: 100%; height: 300rpx; margin-bottom: 20rpx; }
.cover { width: 100%; height: 300rpx; border-radius: 12rpx; }
.cover-fallback { display: flex; align-items: center; justify-content: center; background: var(--line); color: var(--text-light); font-size: 28rpx; }
.input, .picker { border: 2rpx solid var(--line); border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.section-title { margin: 20rpx 0 12rpx; }
.footer { padding: 24rpx; }
.req { color: var(--danger); }
.switch-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0 16rpx; }
