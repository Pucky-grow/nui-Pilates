@import "../management.wxss";

.overview-title, .workspace-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.day-overview { background: #edf1e9; }
.overview-stats { display: flex; gap: 12rpx; margin-top: 20rpx; }
.overview-stats view { flex: 1; min-width: 0; display: flex; flex-direction: column; color: #495643; font-size: 24rpx; }
.overview-number { font-size: 38rpx; font-weight: 650; }
.workspace-group { padding-top: 20rpx; padding-bottom: 16rpx; }
.workspace-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; margin: 0; padding: 18rpx 0; color: var(--text); background: transparent; border-radius: 0; border-bottom: 2rpx solid var(--line); text-align: left; line-height: 1.5; }
.workspace-entry:last-child { border-bottom: 0; }
.workspace-entry::after { border: 0; }
.workspace-entry.button-hover { background: #f7f5f0; }
.entry-copy { flex: 1; min-width: 0; }
.entry-title { font-size: 29rpx; font-weight: 600; }
.entry-chevron, .workspace-link { color: #43563d; font-size: 27rpx; }
.pending-count { color: #775323; font-size: 23rpx; flex-shrink: 0; }
.settings-toggle { padding: 6rpx 0; }
.workspace-footer { padding: 0 12rpx 20rpx; }
