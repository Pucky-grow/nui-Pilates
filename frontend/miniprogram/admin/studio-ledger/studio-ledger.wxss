.ledger-page { padding: 24rpx; }
.heading { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.member-record-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.member-record-heading .heading { min-width: 0; overflow-wrap: anywhere; }
.member-record-heading button { flex-shrink: 0; margin: 0; }
.account-meta, .editor-hint, .ledger-empty { color: #6f6458; font-size: 26rpx; }
.account-meta { overflow-wrap: anywhere; }
.editor-hint { margin-bottom: 20rpx; }
.balance-overview { background: #eff3ec; border-radius: 16rpx; padding: 18rpx 22rpx; margin: 20rpx 0; }
.account-line { display: flex; justify-content: space-between; align-items: baseline; gap: 14rpx; }
.balance-value { font-size: 40rpx; font-weight: 600; color: #3f513b; overflow-wrap: anywhere; }
.actions, .ledger-actions, .ledger-tabs { display: flex; gap: 12rpx; }
.actions { flex-wrap: wrap; margin-top: 16rpx; }
.actions button, .ledger-actions button, .ledger-tabs button, .inline-action, .section-actions button { margin: 0; }
.ledger-actions button { flex: 1; min-width: 0; padding: 0 8rpx; font-size: 28rpx; line-height: 80rpx; }
.editor-actions { margin-top: 24rpx; }
.editor-actions .ledger-primary { flex: 2; }
.ledger-primary, .ledger-secondary, .ledger-link, .ledger-tab, .ledger-refresh { border-radius: 12rpx; }
.ledger-primary { color: #fff; background: #52664b; }
.ledger-primary::after, .ledger-secondary::after, .ledger-link::after, .ledger-tab::after { border: none; }
.ledger-secondary { color: #45583f; background: #fff; box-shadow: inset 0 0 0 2rpx #c4d0be; }
.ledger-link, .ledger-tab { color: #5f554a; background: transparent; }
.ledger-link { padding: 0 12rpx; }
.ledger-link.correction { color: #874733; }
.ledger-shortcuts { justify-content: space-between; }
.ledger-tabs { border-top: 2rpx solid var(--line); margin-top: 16rpx; padding-top: 12rpx; }
.ledger-tab { flex: 1; min-width: 0; padding: 0 4rpx; font-size: 26rpx; line-height: 68rpx; }
.ledger-tab.active { color: #3f513b; background: #eff3ec; font-weight: 600; }
.section-actions, .record-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.section-actions .heading, .record-heading .heading { min-width: 0; }
.settings-panel .actions, .tab-operations .actions { margin-top: 12rpx; }
.settings-row + .settings-row { margin-top: 18rpx; padding-top: 18rpx; border-top: 2rpx solid var(--line); }
.settings-row > button { margin: 12rpx 0 0; }
.workspace-actions .heading { margin-bottom: 0; }
.record-state { flex-shrink: 0; max-width: 48%; color: #45583f; font-size: 24rpx; }
.record-state.pending { color: #855923; }
.record-amount { font-weight: 600; margin: 8rpx 0; }
.ledger-notice, .ledger-error { border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; }
.ledger-notice { background: #eff3ec; color: #3f513b; }
.ledger-error { background: #faede5; color: #793f2e; }
.lesson-check { border-radius: 12rpx; padding: 16rpx 20rpx; margin-top: 16rpx; background: #eff3ec; color: #3f513b; }
.lesson-check.needs-attention { background: #faede5; color: #793f2e; }
.lesson-check-title { font-weight: 600; }
.ledger-refresh { margin-bottom: 16rpx; color: #45583f; background: #eff3ec; }
.pending-row { display: block; width: 100%; padding: 16rpx 0; margin: 0; color: var(--text); background: transparent; border-radius: 0; text-align: left; font-size: 27rpx; line-height: 1.5; }
.pending-row + .pending-row { border-top: 2rpx solid var(--line); }
.pending-row::after { border: 0; }
