.filter-bar { display: flex; padding: 16rpx 24rpx; gap: 16rpx; }
.fb-item { padding: 8rpx 26rpx; border-radius: 30rpx; background: #fff; color: var(--text-light); font-size: 24rpx; }
.fb-item.on { background: var(--sage); color: #fff; }
.c-head { display: flex; justify-content: space-between; align-items: center; }
.c-name { font-size: 30rpx; font-weight: 600; }
.st { font-size: 24rpx; color: var(--sage-deep); }
.row-btns { display: flex; gap: 16rpx; margin-top: 16rpx; }
.row-btns .btn-primary, .row-btns .btn-plain { flex: 1; }
