.input { border: 2rpx solid var(--line); border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.input-area { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; min-height: 120rpx; margin-bottom: 8rpx; width: 100%; box-sizing: border-box; }
.section-title { margin: 20rpx 0 12rpx; }
.footer { padding: 24rpx; }
.req { color: var(--danger); }
.counter { text-align: right; font-size: 22rpx; color: var(--text-light); margin-bottom: 20rpx; }
.time-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.time-row .picker { flex: 1; margin-bottom: 0; }
.picker { border: 2rpx solid var(--line); border-radius: 12rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; }
