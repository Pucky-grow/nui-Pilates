<view class="page">
  <view class="head">
    <text wx:if="{{!loading && !loadError}}" class="display-meta">已选 {{hotCourseIds.length}}/5 门 · {{dirty ? '有未保存修改' : '按下方顺序展示'}}</text>
    <button wx:if="{{canOpenCatalog}}" class="catalog-link" size="mini" bindtap="openCatalog">前往课程目录 ›</button>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{loadError}}" class="empty">加载失败 <text class="link" bindtap="load">重试</text></view>
  <view wx:elif="{{!allCourses.length}}" class="empty">暂无可展示课程</view>

  <block wx:else>
    <view class="card selected-panel">
      <view class="group-title">首页展示顺序</view>
      <view wx:if="{{!selectedList.length}}" class="display-meta">尚未选择</view>
      <view class="sel-item" wx:for="{{selectedList}}" wx:key="id">
        <text class="sel-name">{{item.name}}</text>
        <view wx:if="{{canEdit}}" class="sel-ops">
          <button wx:if="{{index > 0}}" class="op" size="mini" disabled="{{submitting}}" bindtap="moveUp" data-i="{{index}}">上移</button>
          <button wx:if="{{index < selectedList.length - 1}}" class="op" size="mini" disabled="{{submitting}}" bindtap="moveDown" data-i="{{index}}">下移</button>
          <button class="op" size="mini" disabled="{{submitting}}" bindtap="removeSelected" data-id="{{item.id}}">移出首页</button>
        </view>
      </view>
    </view>

    <block wx:if="{{canEdit}}">
      <view wx:if="{{selectedList.length < allCourses.length}}" class="group-title candidates-title">可添加的课程</view>
      <block wx:for="{{allCourses}}" wx:key="id">
        <button wx:if="{{!item.selected}}" class="card item" disabled="{{submitting}}" bindtap="toggle" data-id="{{item.id}}">
          <view>
          <view class="c-name">{{item.name}}</view>
          <view class="muted">{{item.typeText}} · {{item.diffText}}</view>
        </view>
          <text class="link">加入首页</text>
        </button>
      </block>
      <view class="footer">
        <button class="btn-primary" disabled="{{submitting}}" bindtap="submit">{{submitting ? '保存中…' : '保存首页课程展示'}}</button>
      </view>
    </block>
  </block>
</view>
