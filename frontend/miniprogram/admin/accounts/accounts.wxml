<view class="page"><view class="card"><view class="title">修改本人密码</view><view>至少14字符，最多72字节；修改后重新登录。</view><management-form fields="{{ownFields}}" value="{{own}}" disabled="{{busy}}" bindchange="ownChange"/><button bindtap="password" disabled="{{busy}}">修改密码</button></view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{isAdmin}}"><view class="card" wx:for="{{rows}}" wx:key="id"><view>{{item.name}} · {{item.username}} · {{item.status}}</view><view selectable>后台账号编号 #{{item.id}} · {{item.roleText}}</view><button size="mini" data-id="{{item.id}}" bindtap="status" disabled="{{busy}}">{{item.status==='ACTIVE'?'停用':'恢复'}}</button><button size="mini" data-id="{{item.id}}" bindtap="reset">重置口令</button></view><view class="card"><button size="mini" disabled="{{page===1 || busy}}" bindtap="prev">上一页</button><button size="mini" disabled="{{!more || busy}}" bindtap="next">下一页</button></view><view wx:if="{{resetId}}" class="card"><input password maxlength="72" value="{{resetPassword}}" bindinput="resetInput" placeholder="新口令"/><button bindtap="saveReset" disabled="{{busy}}">确认重置</button><button bindtap="cancelReset">取消</button></view><view class="card"><view class="title">创建后台账号</view><view wx:if="{{createdId}}" selectable>已创建后台账号 #{{createdId}}</view><management-form fields="{{fields}}" value="{{form}}" disabled="{{busy}}" bindchange="change"/><button bindtap="create" disabled="{{busy}}">创建</button></view></block></view>
