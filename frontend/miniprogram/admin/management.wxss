.page{padding:24rpx}.toolbar{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap;margin-bottom:24rpx}.toolbar input{flex:1;min-width:180rpx;background:white;padding:20rpx;border-radius:12rpx}.toolbar button,.actions button{font-size:24rpx;margin:0;padding:8rpx 20rpx}.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:20rpx}.title{font-weight:600;font-size:32rpx}.line{padding:12rpx 0;border-bottom:1rpx solid var(--line)}.error{padding:20rpx;background:#fff0e9;color:#9b4934;border-radius:12rpx;margin-bottom:20rpx}.hint{color:var(--text-light);font-size:24rpx;padding:12rpx 0}.status{font-size:24rpx;color:var(--sage-deep)}.stats{display:flex;flex-wrap:wrap;gap:16rpx}.stat{background:#eff3ec;padding:16rpx;border-radius:12rpx;min-width:40%}.bottom{margin:30rpx 0}.danger{color:#9b4934}.form-row{margin:20rpx 0}.input{background:#faf7f2;padding:20rpx;border-radius:10rpx}.menu-item{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.group-title{font-size:24rpx;color:var(--text-light);margin-bottom:16rpx}.empty{padding:50rpx;text-align:center}.date{background:white;padding:16rpx;border-radius:10rpx}
.admin-caption { color: #6f6458; font-size: 25rpx; line-height: 1.5; }
.admin-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 70rpx; margin: 0; padding: 10rpx 22rpx; border-radius: 12rpx; color: #43563d; background: #f1f4ee; font-size: 27rpx; line-height: 1.35; white-space: normal; }
.admin-action::after { border: 0; }
.admin-action.primary { background: #52664b; color: #fff; font-weight: 600; }
.admin-action.secondary { background: #fff; box-shadow: inset 0 0 0 2rpx #c4d0be; }
.admin-action.quiet { background: transparent; }
.admin-action.danger { background: #fbefea; color: #874733; }
.admin-action[disabled] { background: #f0f0eb; color: #756f66; box-shadow: none; }
