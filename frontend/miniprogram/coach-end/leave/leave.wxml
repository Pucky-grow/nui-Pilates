<view class="page">
  <view class="card">
    <view class="section-title">提交请假</view>
    <view class="form-row">
      <text>日期</text>
      <picker mode="date" bindchange="onDate"><view class="picker">{{date || '选择日期'}}</view></picker>
    </view>
    <view class="form-row">
      <text>开始</text>
      <picker mode="time" bindchange="onStart"><view class="picker">{{startTime || '开始时间'}}</view></picker>
    </view>
    <view class="form-row">
      <text>结束</text>
      <picker mode="time" bindchange="onEnd"><view class="picker">{{endTime || '结束时间'}}</view></picker>
    </view>
    <input class="input" placeholder="请假原因" value="{{reason}}" bindinput="onReason" />
    <button class="btn-primary" bindtap="submit">提交请假</button>
  </view>

  <view class="section-title">请假记录</view>
  <view wx:if="{{!leaves.length}}" class="empty">暂无请假记录</view>
  <view class="card" wx:for="{{leaves}}" wx:key="id">
    <view class="l-head"><text>{{item.leaveDate}} {{item.startTime}}-{{item.endTime}}</text><text class="st">{{statusText[item.status]}}</text></view>
    <view class="muted">{{item.reason}}</view>
    <view wx:if="{{item.status=='PENDING'}}" class="btn-plain l-cancel" bindtap="cancel" data-id="{{item.id}}">取消</view>
  </view>
</view>
