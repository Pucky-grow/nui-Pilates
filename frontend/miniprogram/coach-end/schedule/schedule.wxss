.head { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.head button { flex: 1; margin: 0; }
.filter-bar { display: flex; gap: 16rpx; padding: 16rpx 24rpx; white-space: nowrap; overflow-x: auto; }
.fb-item { padding: 8rpx 26rpx; border-radius: 30rpx; background: #fff; color: var(--text-light); font-size: 24rpx; flex-shrink: 0; }
.fb-item.on { background: var(--sage); color: #fff; }
.date-picker { padding: 0 24rpx 12rpx; }
.picker { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 14rpx; font-size: 24rpx; color: var(--text-light); }
.s-head { display: flex; justify-content: space-between; }
.s-date { font-weight: 600; }
.s-time { color: var(--sage-deep); font-weight: 600; }
