.st-head { display: flex; align-items: center; }
.st-avatar { width: 90rpx; height: 90rpx; }
.st-info { flex: 1; margin-left: 18rpx; }
.st-status { color: var(--sage-deep); font-size: 24rpx; }
.st-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.st-btn { flex: 1; font-size: 26rpx; }
