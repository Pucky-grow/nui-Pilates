<view class="page">
  <view class="card" wx:if="{{course}}">
    <view class="section-title">课程封面</view>
    <view class="cover-wrap" bindtap="onCover">
      <image wx:if="{{cover}}" class="cover" src="{{cover}}" mode="aspectFill" />
      <view wx:else class="cover cover-fallback">点击上传封面</view>
    </view>

    <view class="section-title">课程介绍</view>
    <textarea class="input-area" value="{{description}}" data-k="description" bindinput="onInput" placeholder="课程介绍" />

    <view class="section-title">难度</view>
    <picker range="{{difficulties}}" range-key="label" value="{{diffIndex}}" bindchange="onDiff">
      <view class="picker">{{difficulties[diffIndex].label}} ›</view>
    </picker>

    <view class="section-title">适合人群</view>
    <input class="input" value="{{targetUsers}}" data-k="targetUsers" bindinput="onInput" placeholder="适合人群" />

    <view class="section-title">训练重点</view>
    <input class="input" value="{{trainingFocus}}" data-k="trainingFocus" bindinput="onInput" placeholder="训练重点" />

    <view class="section-title">注意事项</view>
    <textarea class="input-area" value="{{notices}}" data-k="notices" bindinput="onInput" placeholder="注意事项" />
  </view>

  <view class="footer">
    <button class="btn-primary" disabled="{{submitting}}" bindtap="submit">{{submitting ? '保存中…' : '保存'}}</button>
  </view>
</view>
