.cover-wrap { width: 100%; height: 320rpx; margin-bottom: 20rpx; }
.cover { width: 100%; height: 320rpx; border-radius: 12rpx; }
.cover-fallback { display: flex; align-items: center; justify-content: center; background: var(--line); color: var(--text-light); font-size: 28rpx; }
.input, .input-area, .picker { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; }
.input-area { min-height: 120rpx; }
.section-title { margin: 24rpx 0 12rpx; }
