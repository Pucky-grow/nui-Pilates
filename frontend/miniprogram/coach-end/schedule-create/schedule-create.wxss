.picker { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; margin-bottom: 20rpx; }
.input { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; margin-bottom: 20rpx; }
.section-title { margin: 20rpx 0 12rpx; }
.member-lookup { display: flex; gap: 12rpx; align-items: center; }
.member-lookup .input { flex: 1; min-width: 0; margin-bottom: 0; }
.member-lookup button, .course-link { margin: 0; }
.member-selected { margin-top: 16rpx; color: var(--sage-deep); }
.duration { margin-top: -8rpx; font-size: 25rpx; line-height: 1.5; }
.form-error { color: #9b4934; margin: 16rpx 0; font-size: 26rpx; line-height: 1.5; }
