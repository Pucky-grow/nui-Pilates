<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载课程和教室…</view>
  <view wx:elif="{{loadError}}" class="card form-error" bindtap="load">{{loadError}}　重试</view>
  <block wx:else>
  <view wx:if="{{booking}}" class="card">
    <view class="section-title">会员</view>
    <view class="member-lookup">
      <input class="input" placeholder="完整手机号或会员编号" value="{{memberReference}}" bindinput="onMember" bindconfirm="lookupMember" confirm-type="search" disabled="{{lookingUp || submitting}}" maxlength="32"/>
      <button class="btn-plain" disabled="{{lookingUp || submitting}}" bindtap="lookupMember">{{lookingUp ? '核对中…' : '核对会员'}}</button>
    </view>
    <view wx:if="{{member}}" class="member-selected">已选 {{member.nickname}} {{member.maskedPhone}}</view>
    <view wx:if="{{memberError}}" class="form-error">{{memberError}}</view>
  </view>
  <view class="card">
    <view class="section-title">课程</view>
    <picker range="{{courseChoices}}" value="{{courseIndex + 1}}" disabled="{{submitting || !courses.length}}" bindchange="onCourse">
      <view class="picker">{{courseIndex >= 0 ? courses[courseIndex].label : courses.length ? '请选择课程' : '暂无可排课程'}} ›</view>
    </picker>
    <view wx:if="{{!courses.length}}" class="muted">上架且已获授课资格的课程会出现在这里。</view>
    <button class="btn-plain course-link" disabled="{{submitting}}" bindtap="goCourses">课程中心</button>

    <view class="section-title">上课日期</view>
    <picker mode="date" value="{{courseDate}}" start="{{today}}" disabled="{{submitting}}" bindchange="onDate">
      <view class="picker">{{courseDate || '请选择日期'}} ›</view>
    </picker>

    <view class="section-title">开始时间</view>
    <picker mode="time" value="{{startTime}}" disabled="{{submitting}}" bindchange="onStart"><view class="picker">{{startTime}} ›</view></picker>
    <view wx:if="{{courseIndex >= 0}}" class="muted duration">{{endTime ? courses[courseIndex].durationMinutes + ' 分钟，预计 ' + endTime + ' 结束' : '请选可在当天内完成课程的时间。'}}</view>

    <view class="section-title">教室</view>
    <picker range="{{roomChoices}}" value="{{roomIndex + 1}}" disabled="{{submitting || !classrooms.length}}" bindchange="onRoom">
      <view class="picker">{{roomIndex >= 0 ? classrooms[roomIndex].name : '请选择教室'}} ›</view>
    </picker>

    <view class="section-title">人数上限</view>
    <view wx:if="{{privateClass}}">一对一私教 · 1 人</view>
    <input wx:else class="input" type="number" value="{{maxCapacity}}" disabled="{{submitting}}" bindinput="onCap" placeholder="如 8" />
    <block wx:if="{{booking}}">
      <view class="section-title">代约原因</view>
      <input class="input" value="{{reason}}" maxlength="255" disabled="{{submitting}}" bindinput="onReason" placeholder="例如会员已确认上课时间"/>
    </block>
  </view>

  <view class="footer">
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <button class="btn-primary" disabled="{{submitting || lookingUp || !courses.length || !classrooms.length}}" loading="{{submitting}}" bindtap="submit">{{booking ? '确认排课并代约' : '创建排课'}}</button>
  </view>
  </block>
</view>
