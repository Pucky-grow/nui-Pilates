.input { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; width: 100%; box-sizing: border-box; }
.area { height: 160rpx; }
.form-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.picker { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 10rpx 20rpx; min-width: 200rpx; font-size: 26rpx; }
.seg { display: flex; gap: 12rpx; }
.seg-item { padding: 8rpx 24rpx; border-radius: 30rpx; background: #fff; font-size: 24rpx; }
.seg-item.on { background: var(--sage); color: #fff; }
.footer { display: flex; gap: 20rpx; padding: 24rpx; }
.footer .btn-plain, .footer .btn-primary { flex: 1; }
