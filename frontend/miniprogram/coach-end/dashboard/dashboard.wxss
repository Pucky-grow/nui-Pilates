.head { font-size: 36rpx; font-weight: 600; padding: 24rpx; }
.input { border: 2rpx solid var(--line); border-radius: 12rpx; padding: 16rpx; margin-bottom: 20rpx; }
.s-head { display: flex; justify-content: space-between; }
.s-time { font-weight: 600; color: var(--sage-deep); }
.bind-btn { margin-top: 16rpx; }
.stats { display: flex; }
.stat { flex: 1; text-align: center; display: flex; flex-direction: column; gap: 4rpx; }
.stat .n { font-size: 36rpx; font-weight: 700; color: var(--sage-deep); }
